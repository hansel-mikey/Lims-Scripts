    return "";
  };

  // ============================================================
  // HELPERS
  // ============================================================

  const sleep = ms =>
    new Promise(resolve => setTimeout(resolve, ms));

  const normalize = value =>
    (value || "").trim().toLowerCase();

  function isVisible(element) {
    if (!element) return false;

    const rect = element.getBoundingClientRect();
    const style = getComputedStyle(element);

    return (
      rect.width > 0 &&
      rect.height > 0 &&
      style.display !== "none" &&
      style.visibility !== "hidden"
    );
  }

  function clickElement(element) {
    if (!element) {
      throw new Error("Element not found");
    }

    element.scrollIntoView({
      behavior: "instant",
      block: "center"
    });

    element.click();
  }

  function getVisibleElements(selector, root = document) {
    return [...root.querySelectorAll(selector)]
      .filter(isVisible);
  }

  function setInputValue(input, value) {
    const setter = Object.getOwnPropertyDescriptor(
      HTMLInputElement.prototype,
      "value"
    ).set;

    setter.call(input, value);

    input.dispatchEvent(
      new Event("input", { bubbles: true })
    );

    input.dispatchEvent(
      new Event("change", { bubbles: true })
    );
  }

  // ============================================================
  // FIND MATERIAL ELEMENT
  // ============================================================

  function findMaterialElement(materialName) {
    const matches = [
      ...document.querySelectorAll("*")
    ].filter(element =>
      element.children.length === 0 &&
      normalize(element.textContent) === normalize(materialName) &&
      isVisible(element)
    );

    if (!matches.length) {
      throw new Error(`Material not found: ${materialName}`);
    }

    return matches[0];
  }

  // ============================================================
  // FIND EYE BUTTON
  // Search material hierarchy and inspect SVG path.
  // ============================================================

  function getEyeButtonFromContainer(container) {
    if (!container) return null;

    return [
      ...container.querySelectorAll('button, [role="button"]')
    ].find(button => {

      if (!isVisible(button)) return false;

      return [
        ...button.querySelectorAll("svg path")
      ].some(path => {
        const d = (path.getAttribute("d") || "")
          .replace(/\s+/g, " ")
          .trim();

        return d.startsWith(EYE_PATH);
      });

    }) || null;
  }

  async function searchMaterial(materialName) {
    const searchInput =
      document.querySelector(SEARCH_SELECTOR);

    if (!searchInput) {
      throw new Error("Material search input not found");
    }

    searchInput.focus();
    setInputValue(searchInput, materialName);

    await sleep(LONG_WAIT);

    const materialElement =
      findMaterialElement(materialName);

    // Find Expand button in the material hierarchy
    let parent = materialElement;
    let expandButton = null;

    for (let i = 0; i < 12 && parent; i++) {
      expandButton = [
        ...parent.querySelectorAll(
          'button[aria-label="Expand"], button[title="Expand"]'
        )
      ].find(isVisible);

      if (expandButton) break;

      parent = parent.parentElement;
    }

    if (expandButton) {
      clickElement(expandButton);
      await sleep(LONG_WAIT);
      console.log("Expanded:", materialName);
    }

    return findMaterialElement(materialName);
  }

  async function openGradeList(materialName) {
    console.log("Finding eye button:", materialName);

    const materialElement =
      findMaterialElement(materialName);

    let parent = materialElement;
    let eyeButton = null;

    for (let i = 0; i < 12 && parent; i++) {
      eyeButton = getEyeButtonFromContainer(parent);

      if (eyeButton) break;

      parent = parent.parentElement;
    }

    if (!eyeButton) {
      console.error("Eye button not found. Visible buttons:");

      console.table(
        getVisibleElements("button").map((button, index) => ({
          index,
          text: button.innerText,
          title: button.title,
          ariaLabel: button.getAttribute("aria-label"),
          svgPaths: [
            ...button.querySelectorAll("svg path")
          ].map(path => path.getAttribute("d")).join(" | "),
          html: button.outerHTML.slice(0, 300)
        }))
      );

      throw new Error(
        `Eye button not found for ${materialName}`
      );
    }

    clickElement(eyeButton);
    await sleep(LONG_WAIT);

    console.log("Eye button clicked:", materialName);

    findParametersBox(materialName);
  }

  // ============================================================
  // FIND PARAMETERS BOX
  // ============================================================

  function findParametersBox(materialName) {
    const expectedHeading = normalize(
      `Parameters for ${materialName}`
    );

    const headings = [
      ...document.querySelectorAll("h3")
    ].filter(element =>
      normalize(element.textContent) === expectedHeading &&
      isVisible(element)
    );

    if (!headings.length) {
      throw new Error(
        `Parameters heading not found: ${materialName}`
      );
    }

    let parent = headings[headings.length - 1];

    for (let i = 0; i < 8 && parent; i++) {
      parent = parent.parentElement;
      if (!parent) break;

      const table = parent.querySelector("table");

      if (table && table.querySelector("tbody tr")) {
        return { container: parent, table };
      }
    }

    throw new Error(
      `Parameter table not found: ${materialName}`
    );
  }

  // ============================================================
  // READ PARAMETERS
  // ============================================================

  function getAvailableParameters(materialName) {
    const { table } = findParametersBox(materialName);

    const rows = [
      ...table.querySelectorAll("tbody > tr")
    ];

    const parameters = [];

    for (const row of rows) {
      const cells = row.querySelectorAll("td");

      if (cells.length < 5) continue;

      const code = cells[1].textContent.trim();

      if (!code) continue;

      parameters.push({
        code,
        name: cells[2].textContent.trim(),
        type: cells[3].textContent.trim(),
        editButton: row.querySelector('button[title="Edit"]'),
        row
      });
    }

    console.table(
      parameters.map(parameter => ({
        code: parameter.code,
        name: parameter.name,
        type: parameter.type,
        editable: !!parameter.editButton
      }))
    );

    return parameters;
  }

  function findParameterRow(materialName, gradeName) {
    const parameters =
      getAvailableParameters(materialName);

    const parameter = parameters.find(item =>
      normalize(item.code) === normalize(gradeName)
    );

    if (!parameter) return null;

    if (
      !parameter.editButton ||
      !isVisible(parameter.editButton)
    ) {
      throw new Error(
        `Edit button unavailable for ${gradeName}`
      );
    }

    return parameter;
  }

  // ============================================================
  // VALIDATE ALL GRADES BEFORE UPDATING
  // ============================================================

  function validateMaterialGrades(item) {
    const parameters =
      getAvailableParameters(item.material);

    const availableCodes = new Set(
      parameters.map(parameter =>
        normalize(parameter.code)
      )
    );

    const missingGrades = [];
    const foundGrades = [];

    for (const gradeItem of item.grades) {
      if (availableCodes.has(normalize(gradeItem.grade))) {
        foundGrades.push(gradeItem.grade);
      } else {
        missingGrades.push(gradeItem.grade);
      }
    }

    console.log("Found:", foundGrades);
    console.log("Missing:", missingGrades);

    return {
      valid: missingGrades.length === 0,
      foundGrades,
      missingGrades
    };
  }

  // ============================================================
  // UPDATE UNIT
  // ============================================================

  async function updateGradeUnit(
    materialName,
    gradeName,
    unit
  ) {
    const parameter =
      findParameterRow(materialName, gradeName);

    if (!parameter) {
      throw new Error(`Parameter not found: ${gradeName}`);
    }

    console.log(`Editing ${gradeName} → ${unit}`);

    clickElement(parameter.editButton);
    await sleep(WAIT);

    const unitInputs =
      getVisibleElements(UNIT_SELECTOR);

    const unitInput =
      unitInputs[unitInputs.length - 1];

    if (!unitInput) {
      throw new Error(
        `Unit input not found for ${gradeName}`
      );
    }

    setInputValue(unitInput, unit);
    await sleep(300);

    const updateButton = getVisibleElements("button")
      .find(button =>
        normalize(button.innerText)
          .includes("update parameter")
      );

    if (!updateButton) {
      throw new Error("Update Parameter button not found");
    }

    clickElement(updateButton);

    // Native window.prompt() is handled by the override.
    await sleep(LONG_WAIT);

    console.log(`UPDATED: ${gradeName} → ${unit}`);

    return "SUCCESS";
  }

  // ============================================================
  // CLICK DONE BUTTON
  // ============================================================

  async function clickDoneButton(materialName) {
    const { container } =
      findParametersBox(materialName);

    const doneButton = [
      ...container.querySelectorAll("button")
    ].find(button =>
      isVisible(button) &&
      button.innerText.trim().toLowerCase() === "done"
    );

    if (!doneButton) {
      throw new Error(
        `Done button not found for ${materialName}`
      );
    }

    clickElement(doneButton);

    await sleep(LONG_WAIT);

    console.log("Done clicked:", materialName);
  }

  // ============================================================
  // PROCESS MATERIAL
  // ============================================================

  async function processMaterial(item, results) {
    console.log("\n==================================");
    console.log("PROCESSING:", item.material);
    console.log("==================================");

    let parametersBoxOpened = false;

    try {
      await searchMaterial(item.material);

      await openGradeList(item.material);

      parametersBoxOpened = true;

      const validation =
        validateMaterialGrades(item);

      if (!validation.valid) {
        console.warn(
          "SKIPPED - Missing parameters:",
          validation.missingGrades
        );

        results.skippedMaterials.push({
          material: item.material,
          reason: "Missing requested parameters",
          missingGrades: validation.missingGrades
        });

        return;
      }

      results.validatedMaterials.push(item.material);

      for (const gradeItem of item.grades) {
        try {
          await updateGradeUnit(
            item.material,
            gradeItem.grade,
            gradeItem.unit
          );

          results.success.push({
            material: item.material,
            grade: gradeItem.grade,
            unit: gradeItem.unit
          });

        } catch (error) {
          console.error(
            `FAILED: ${gradeItem.grade}`,
            error.message
          );

          results.failed.push({
            material: item.material,
            grade: gradeItem.grade,
            unit: gradeItem.unit,
            error: error.message
          });
        }

        await sleep(WAIT);
      }

    } catch (error) {
      console.error(
        `MATERIAL ERROR: ${item.material}`,
        error.stack || error
      );

      results.skippedMaterials.push({
        material: item.material,
        reason: error.message,
        missingGrades: []
      });

    } finally {

      // Close Parameters box after updates or validation skip
      if (parametersBoxOpened) {
        try {
          await clickDoneButton(item.material);
        } catch (error) {
          console.error(
            "Could not click Done:",
            error.message
          );

          results.doneButtonFailures.push({
            material: item.material,
            error: error.message
          });
        }
      }
    }
  }

  // ============================================================
  // MAIN EXECUTION
  // ============================================================

  const results = {
    success: [],
    failed: [],
    skippedMaterials: [],
    validatedMaterials: [],
    doneButtonFailures: []
  };

  try {
    console.log("STARTING MATERIAL UNIT UPDATES");
    console.log("Total materials:", gradeUpdates.length);
    console.log("Common grades per material:", commonGrades.length);

    for (const item of gradeUpdates) {
      await processMaterial(item, results);
    }

  } catch (error) {
    console.error("MAIN EXECUTION ERROR:", error);

  } finally {

    console.log("\n========== FINAL SUMMARY ==========");

    console.log("Total materials:", gradeUpdates.length);
    console.log("Validated materials:", results.validatedMaterials.length);
    console.log("Skipped materials:", results.skippedMaterials.length);
    console.log("Successful updates:", results.success.length);
    console.log("Failed updates:", results.failed.length);
    console.log("Done button failures:", results.doneButtonFailures.length);

    console.log("\nSUCCESSFUL UPDATES:");
    console.table(results.success);

    console.log("\nFAILED UPDATES:");
    console.table(results.failed);

    console.log("\nSKIPPED MATERIALS:");
    console.table(results.skippedMaterials);

    console.log("\nDONE BUTTON FAILURES:");
    console.table(results.doneButtonFailures);

    window.alert = originalAlert;
    window.prompt = originalPrompt;

    console.log("SCRIPT COMPLETED.");
  }

  return results;

})().catch(error => {
  console.error("FATAL ERROR:", error.stack || error);
});
