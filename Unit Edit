  const EYE_PATH = "M2.036 12.322";

  const WAIT = 700;
  const LONG_WAIT = 1200;

  // ============================================================
  // ALERT / PROMPT HANDLING
  // ============================================================

  const originalAlert = window.alert;
  const originalPrompt = window.prompt;

  window.alert = message => {
    console.log("Alert handled:", message);
  };

  // Native prompt: empty reason, equivalent to clicking OK.
  window.prompt = (message, defaultValue = "") => {
