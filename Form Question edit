    if (getSearchInput()) return;
    history.back();
    if (!(await waitFor(getSearchInput, 8000))) throw new Error("Not on the forms list page and could not go back to it");
    await sleep(800);
  }

  async function openFormForEdit(name) {
    await ensureOnListPage();
    let rows = [];
    for (let attempt = 1; attempt <= CFG.searchRetries + 1 && !rows.length; attempt++) {
      const search = await waitFor(getSearchInput);
      if (!search) throw new Error("Search input not found – are you on the forms list page?");
      search.focus();
      setNativeValue(search, "");
      await sleep(400);
      setNativeValue(search, name);
      await sleep(CFG.searchDelay * attempt); // wait longer on each retry
      await waitFor(() => matchingRows(name).length, 5000 * attempt);
      await sleep(300); // let the table finish rendering so duplicates are counted
      rows = matchingRows(name);
      if (!rows.length && attempt <= CFG.searchRetries) warn(`"${name}" not found, retrying search (${attempt})…`);
    }
    if (!rows.length) {
      const seen = visibleRowNames().slice(0, 5);
      throw new SkipError("NOT FOUND",
        `Form not found. Search showed: ${seen.length ? seen.join(" | ") : "(no rows)"}`);
    }
    if (rows.length > 1 && CFG.skipDuplicates) {
      throw new SkipError("DUPLICATE",
        `${rows.length} forms share this exact name – server will reject the save (409). Rename/delete the duplicate first.`);
    }
    const foundName = norm(rowName(rows[0]));
    if (foundName !== norm(name)) log(`  matched "${foundName}" (case/space difference)`);
    const edit = rows[0].querySelector('button[title="Edit"]');
    if (!edit) throw new Error("Edit button not found in row");
    edit.click();

    const ready = await waitFor(() =>
      document.querySelector(TA_SEL) || buttonByText("Add Question") || buttonByText("Save Form"));
    if (!ready) throw new Error("Edit page did not load");
    await sleep(1000); // let all existing questions render
  }

  // ===================== EDIT PAGE ======================
  async function deleteAllQuestions() {
    let guard = 0;
    while (true) {
      checkStop();
      const btns = [...document.querySelectorAll('button[title="Delete question"]')].filter(visible);
      if (!btns.length) return 0;
      if (++guard > 300) throw new Error("Too many delete attempts");
      const before = btns.length;
      btns[btns.length - 1].click(); // delete from the bottom up
      await sleep(CFG.stepDelay);
      await confirmDialogIfAny();
      const dropped = await waitFor(
        () => document.querySelectorAll('button[title="Delete question"]').length < before, 4000);
      if (!dropped) {
        warn(`Could not delete further – ${before} question(s) remain; will reuse them.`);
        return before;
      }
    }
  }

  async function fillCard(ta, text) {
    ta.focus();
    setNativeValue(ta, text);
    ta.blur();
    await sleep(CFG.stepDelay);

    const card = getCard(ta);
    if (CFG.mapToParameter) {
      await ensureChecked(card.querySelector('input[id^="mapToParameter-"]'));
      // Parameter name input appears after ticking the checkbox → fill with the question name
      const param = await waitFor(() => getCard(ta).querySelector('input[placeholder="e.g. C, MN, SI"]'), 5000);
      if (param) {
        param.focus();
        setNativeValue(param, text);
        param.blur();
        await sleep(CFG.stepDelay);
        if (param.value !== text) warn(`Parameter mismatch for "${text}" (got "${param.value}")`);
      } else {
        warn(`Parameter input not found for "${text}"`);
      }
    }
    if (CFG.required) await ensureChecked(getCard(ta).querySelector('input[id^="required-"]'));
    if (ta.value !== text) warn(`Text mismatch for "${text}" (got "${ta.value}")`);
  }

  async function addQuestion(text) {
    const before = new Set(document.querySelectorAll(TA_SEL));
    let ta = null;
    for (let attempt = 1; attempt <= CFG.addRetries && !ta; attempt++) {
      let btn;
      if (before.size === 0) {
        btn = buttonByText("Add Question");
      } else {
        const belowBtns = [...document.querySelectorAll('button[title="Add question below"]')].filter(visible);
        btn = belowBtns[belowBtns.length - 1]; // add after the last question
      }
      if (!btn) { await sleep(1000); continue; }
      btn.scrollIntoView({ block: "center" });
      await sleep(200);
      btn.click();
      ta = await waitFor(() => [...document.querySelectorAll(TA_SEL)].find((t) => !before.has(t)), 5000);
      if (!ta && attempt < CFG.addRetries) warn(`New box for "${text}" didn't appear, retrying (${attempt})…`);
    }
    if (!ta) throw new Error(`New question box did not appear for "${text}"`);
    ta.scrollIntoView({ block: "center" });
    await sleep(CFG.stepDelay);
    await fillCard(ta, text);
  }

  async function saveAndReturn() {
    const save = buttonByText("Save Form");
    if (!save) throw new Error('"Save Form" button not found');
    if (CFG.dryRun) {
      log("DRY RUN – not saving.");
      await sleep(CFG.afterSaveDelay);
    } else {
      const mark = apiLog.length;
      save.click();
      const res = await waitFor(() => apiLog[mark], CFG.timeout);
      if (!res) warn("No save response seen from the server – check this form manually.");
      else if (res.status >= 400) {
        throw new SkipError("SAVE FAILED", `Server returned ${res.status}${res.msg ? `: ${res.msg}` : ""}`);
      }
      await sleep(CFG.afterSaveDelay);
    }

    let search = await waitFor(getSearchInput, 5000);
    if (!search) { history.back(); search = await waitFor(getSearchInput, 8000); }
    if (!search) throw new Error("Could not get back to the forms list after saving");
    await sleep(800);
  }

  // ===================== MAIN ===========================
  window.__formBotStop = false;
  const results = [];
  const toRun = CFG.onlyNames.length
    ? FORMS.filter((f) => CFG.onlyNames.map(norm).includes(norm(f.Name)))
    : FORMS;
  log(`Processing ${toRun.length} form(s)…`);
  try {
    for (const form of toRun) {
      const questions = (form.Materials || []).map(norm).filter(Boolean);
      log(`▶ ${form.Name}  (${questions.length} questions)`);
      try {
        checkStop();
        await openFormForEdit(form.Name);

        const leftover = await deleteAllQuestions();
        let i = 0;
        // If the form won't allow deleting the last card(s), overwrite them first
        const existing = [...document.querySelectorAll(TA_SEL)].slice(0, leftover);
        for (const ta of existing) {
          if (i >= questions.length) break;
          await fillCard(ta, questions[i++]);
        }
        for (; i < questions.length; i++) {
          checkStop();
          log(`  + ${questions[i]}`);
          await addQuestion(questions[i]);
        }

        await saveAndReturn();
        results.push({ form: form.Name, status: "OK", questions: questions.length });
        log(`✔ ${form.Name} saved`);
      } catch (e) {
        const status = e instanceof SkipError ? e.status : "ERROR";
        results.push({ form: form.Name, status, error: e.message });
        console.error(`[FormBot] ✖ ${form.Name} → ${status}: ${e.message}`);
        if (e.message === "Stopped by user") break;
        // get back to the list so the next form can continue
        try { await ensureOnListPage(); } catch (_) {}
      }
    }
  } finally {
    window.confirm = origConfirm;
    XMLHttpRequest.prototype.open = origOpen;
    XMLHttpRequest.prototype.send = origSend;
    window.fetch = origFetch;

    console.table(results);
    const failed = results.filter((r) => r.status !== "OK").map((r) => r.form);
    window.__formBotResults = results;
    window.__formBotFailed = failed;
    const ok = results.length - failed.length;
    log(`Done. ${ok} OK, ${failed.length} not done.`);
    if (failed.length) {
      log("To re-run only the failed forms, paste this into CFG.onlyNames:");
      console.log(JSON.stringify(failed));
    }
  }
})();
